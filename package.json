{
  "name": "qr-to-dxf",
  "version": "0.1.0",
  "description": "Generate DXF files from QR codes for laser cutting and CNC machining",
  "sideEffects": false,
  "keywords": [
    "qr-code",
    "dxf",
    "cad",
    "laser-cutting",
    "cnc",
    "manufacturing",
    "qrcode",
    "autocad",
    "laser-engraving"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "prepare": "husky",
    "prepublishOnly": "npm run type-check && npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "qrcode": "^1.5.3",
    "@tarikjabiri/dxf": "^2.8.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^10.0.0",
    "@semantic-release/npm": "^12.0.0",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.5",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "semantic-release": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^7.0.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nakashun-mf/npm_qr2dxf.git"
  },
  "homepage": "https://github.com/Nakashun-mf/npm_qr2dxf#readme",
  "bugs": {
    "url": "https://github.com/Nakashun-mf/npm_qr2dxf/issues"
  },
  "author": "Nakashun-mf",
  "license": "MIT"
}
