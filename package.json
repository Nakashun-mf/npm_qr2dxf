{
  "name": "qr-to-dxf",
  "version": "0.1.0",
  "description": "Generate DXF files from QR codes for laser cutting and CNC machining",
  "keywords": [
    "qr-code",
    "dxf",
    "cad",
    "laser-cutting",
    "cnc",
    "manufacturing",
    "qrcode",
    "autocad",
    "laser-engraving"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "prepublishOnly": "npm run build && npm run test"
  },
  "dependencies": {
    "qrcode": "^1.5.3",
    "@tarikjabiri/dxf": "^2.8.9"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "tsup": "^8.0.0",
    "vitest": "^1.6.0",
    "@types/qrcode": "^1.5.5",
    "@types/node": "^20.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nakashun-mf/qr-to-dxf"
  },
  "homepage": "https://github.com/Nakashun-mf/qr-to-dxf#readme",
  "bugs": {
    "url": "https://github.com/Nakashun-mf/qr-to-dxf/issues"
  },
  "author": "Nakashun-mf",
  "license": "MIT"
}
